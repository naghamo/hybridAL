# =============================================================================
# WHITELIST approach: ignore everything by default; re-include only the
# paper-essential code. Anything not explicitly re-included below is
# considered build artifact / runtime / scratch / data and stays out of
# the repo.
#
# What lives in the repo:
#   README.md  requirements.txt  main.py
#   _calibration_normalizers.json   (paper-input artifact)
#   adaptive_al/                  — model + AL strategies + samplers + evaluation
#   experiments_lib/runners/      — one module per experiment that builds a plan
#   experiments_lib/aggregators/  — one module per experiment that aggregates results
#   experiments_lib/shared/       — shared utilities
#
# Everything else (data/, experiments/, results/, scratch/, media/,
# eda_preprocessing/, _*.py runtime scripts, *.log, *.ipynb, etc.) is
# ignored.
#
# Important: gitignore only blocks NEW untracked paths. Files that were
# added to the index before this rule took effect remain tracked. To
# clear them:
#     git rm -r --cached <path>
#     git commit -m "stop tracking <path>"
# =============================================================================

# Ignore everything at the repo root.
*

# Re-include the small set of paper-essential top-level files.
# .gitignore itself stays local — don't track it.
!/README.md
!/requirements.txt
!/main.py
!/_calibration_normalizers.json

# Re-include the paper-essential code directories (the dir entry first,
# then everything inside it recursively).
!/adaptive_al/
!/adaptive_al/**
!/experiments_lib/
!/experiments_lib/**

# Re-exclude code that produces paper figures/tables but is not part of
# the method itself. These directories generate plots and LaTeX tables
# from the experiment CSVs; reviewers do not need them to reproduce the
# experiments. Leave the files on disk; just don't ship them with the
# code release.
/experiments_lib/plotting/
/experiments_lib/plotting/**
/scratch/
/scratch/**
/tables/
/tables/**
/media/
/logs/
*.log
*.ipynb

# Re-ignore Python / IDE / env build artifacts that may sit inside the
# code dirs above.
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.idea/
.env
.claude/

# Re-ignore any local OS metadata files that might creep in.
.DS_Store
Thumbs.db
